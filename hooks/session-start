#!/usr/bin/env bash
# SessionStart hook for own-skills plugin (Claude Code only).
#
# Extensionless filename: Claude Code's Windows handling auto-prepends
# "bash" to any command that contains ".sh", so naming this file
# "session-start.sh" and also setting "shell": "bash" in hooks.json would
# risk a double-wrapped invocation.

set -euo pipefail

context='<EXTREMELY_IMPORTANT>\nDu har egna skills installerade: brainstorming, test-driven-development, systematic-debugging, verification-before-completion, writing-plans, finishing-a-development-branch.\n\nOm det finns en rimlig chans att en skill passar uppgiften MÅSTE du använda den, innan du svarar eller agerar - även före klargörande frågor. En enkel fråga är också en uppgift.\n\nAnvänd Skill-verktyget för att anropa en skill vid namn.\n</EXTREMELY_IMPORTANT>'

printf '{\n  "hookSpecificOutput": {\n    "hookEventName": "SessionStart",\n    "additionalContext": "%s"\n  }\n}\n' "$context"

exit 0
